# Safety NLP Pipeline - Environment Configuration
# Copy this file to .env and adjust values as needed

# Backend API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# CORS Origins (comma-separated or JSON array)
# For local development with Vite + Tauri
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","tauri://localhost"]

# For Docker deployment
# CORS_ORIGINS=["http://localhost","http://localhost:80"]

# Logging
LOG_LEVEL=INFO

# Data Paths (relative to project root)
# These are auto-configured in config.py but can be overridden
# BASE_DIR=/app/safety_nlp_pipeline
# DATA_DIR=/app/safety_nlp_pipeline/data
# MODEL_PATH=/app/safety_nlp_pipeline/data/safety_model.pkl

# Model Settings
RAG_TOP_K=3
RAG_BATCH=200
RAG_EVIDENCE_SNIPPET=170

# Monitor Settings
MONITOR_POLL_SECONDS=60
MONITOR_ALERT_SNIPPET=200

# External API Settings
NTSB_API_URL=https://api.ai-analytics.org/api/v1/ntsb/aviation/recent
NTSB_POLL_SECONDS=3600

UKPN_API_URL=https://ukpowernetworks.opendatasoft.com/api/explore/v2.1/catalog/datasets/ukpn-live-faults/records
UKPN_POLL_SECONDS=60

ALERT_HIGH_MIN_CUSTOMERS=100